# Bio Star Monde Éden — configuration
# Promoteur : M. ZOUBGA NATHANAËL
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# --- Pi Developer Portal (compte du promoteur) ---
# Clé API serveur de l'application (Testnet, puis une nouvelle clé pour le Mainnet). Jamais côté navigateur.
PI_API_KEY=
# false dans le Pi Browser (Testnet ou Mainnet). true uniquement pour le Sandbox sur ordinateur.
PI_SANDBOX=false
# testnet ou mainnet
PI_NETWORK=testnet
# Clé « Verify domain » du Developer Portal, servie sur /validation-key.txt
PI_VALIDATION_KEY=
# Noms d'utilisateur Pi autorisés à l'administration, séparés par des virgules (sans @)
ADMIN_USERNAMES=
# Origines autorisées à afficher l'application dans un cadre (Sandbox, Pi Browser)
FRAME_ANCESTORS='self' https://minepi.com https://*.minepi.com https://pinet.com https://*.pinet.com https://*.piappengine.com

# --- Base de données ---
# Production : Supabase (clé service_role, à garder secrète, jamais dans le dépôt).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_TABLE_PREFIX=bsme_
# Sans SUPABASE_URL : base SQLite locale (développement).
DATABASE_PATH=./data/biostar.db

CONTACT_EMAIL=zoubgaefils@gmail.com
